---
// 🖨️ Imprimir unidad completa — renderiza índice + todas las fichas de la
// unidad seguidas, con salto de página entre fichas. Fuera de Starlight:
// es una página mínima pensada solo para imprimir (o "Guardar como PDF"
// desde el navegador — decisión: sin generación de PDF en CI).
import { getCollection, render } from 'astro:content';
import '../../styles/custom.css';
import '@fontsource/geist-sans';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  const slugs = new Set(
    docs
      .map((e) => e.id.split('/')[0])
      .filter((s) => /^\d{2}-/.test(s)),
  );
  return [...slugs].map((unidad) => ({ params: { unidad } }));
}

const { unidad } = Astro.params;
const base = import.meta.env.BASE_URL;

const docs = await getCollection('docs');
const entries = docs
  .filter((e) => e.id === unidad || e.id.startsWith(`${unidad}/`))
  .sort((a, b) => {
    if (a.id === unidad) return -1;
    if (b.id === unidad) return 1;
    return a.id.localeCompare(b.id, 'es');
  });

const rendered = [];
for (const entry of entries) {
  const { Content } = await render(entry);
  rendered.push({ entry, Content });
}

const unitTitle = entries[0]?.data.title ?? unidad;
const fichas = rendered.length;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>🖨️ Imprimir · {unitTitle} — Tutoría FPB</title>
    <style is:global>
      body.print-unit {
        margin: 0;
        background: #f1f5fb;
        color: #1a2332;
        font-family: 'Geist Sans', 'Inter', system-ui, sans-serif;
        line-height: 1.55;
      }
      .print-head {
        position: sticky;
        top: 0;
        z-index: 5;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.8rem 1.2rem;
        background: #2563eb;
        color: #fff;
        box-shadow: 0 2px 12px rgba(37, 99, 235, 0.25);
      }
      .print-head strong { font-size: 1.05rem; }
      .print-head .sub { opacity: 0.85; font-size: 0.85rem; display: block; }
      .print-actions { display: flex; gap: 0.6rem; align-items: center; }
      .print-actions a,
      .print-actions button {
        font: inherit;
        font-size: 0.92rem;
        padding: 0.5rem 0.95rem;
        border-radius: 0.55rem;
        cursor: pointer;
        text-decoration: none;
        border: 1px solid rgba(255, 255, 255, 0.55);
        background: rgba(255, 255, 255, 0.12);
        color: #fff;
      }
      .print-actions button { background: #fff; color: #2563eb; border-color: #fff; font-weight: 700; }
      .print-ficha {
        max-width: 210mm;
        margin: 1.4rem auto;
        padding: 1.6rem 1.8rem 2rem;
        background: #fff;
        border: 1px solid #dbe4f3;
        border-radius: 0.7rem;
        box-shadow: 0 8px 30px rgba(37, 99, 235, 0.08);
      }
      .print-ficha .ficha-t {
        margin: 0 0 1rem;
        padding-bottom: 0.55rem;
        border-bottom: 3px solid #2563eb;
        font-size: 1.35rem;
        color: #2563eb;
      }
      /* Base de contenido (Starlight CSS no aplica aquí) */
      .sl-anchor-link { display: none; }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
        border: 0;
      }
      table {
        border-collapse: collapse;
        width: 100%;
        margin: 0.8rem 0;
        font-size: 0.95rem;
      }
      th, td {
        border: 1px solid #c9d6ee;
        padding: 0.4rem 0.6rem;
        text-align: left;
        vertical-align: top;
      }
      th { background: #e3edff; }
      blockquote {
        margin: 0.8rem 0;
        padding: 0.5rem 0.9rem;
        border-left: 4px solid #2563eb;
        background: #eef4ff;
        border-radius: 0 0.5rem 0.5rem 0;
      }
      hr {
        border: none;
        border-top: 1px solid #d7e1f2;
        margin: 1.1rem 0;
      }
      code {
        background: #f1f5f9;
        padding: 0.1rem 0.35rem;
        border-radius: 0.3rem;
        font-size: 0.92em;
      }
      ul, ol { padding-left: 1.4rem; }
      li { margin: 0.25rem 0; }
      img { max-width: 100%; }
      @media print {
        body.print-unit { background: #fff; }
        .no-print, .sl-anchor-link { display: none !important; }
        .print-ficha {
          max-width: 100%;
          margin: 0;
          padding: 0;
          border: none;
          border-radius: 0;
          box-shadow: none;
          break-after: page;
          page-break-after: always;
        }
        .print-ficha:last-of-type {
          break-after: auto;
          page-break-after: auto;
        }
      }
    </style>
  </head>
  <body class="print-unit">
    <header class="print-head no-print">
      <div>
        <strong>🖨️ {unitTitle}</strong>
        <span class="sub">{fichas} páginas de contenido · Tutoría FPB</span>
      </div>
      <div class="print-actions">
        <a href={`${base}/`}>← Volver al inicio</a>
        <button type="button" onclick="window.print()">🖨️ Imprimir / Guardar PDF</button>
      </div>
    </header>

    {rendered.map(({ entry, Content }) => (
      <section class="print-ficha">
        <h1 class="ficha-t">{entry.data.title}</h1>
        <Content />
      </section>
    ))}
  </body>
</html>
