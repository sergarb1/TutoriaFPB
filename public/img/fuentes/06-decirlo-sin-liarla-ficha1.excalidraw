    {
      "id": "s1-label",
      "type": "text",
      "x": 40,
      "y": 212.5,
      "width": 280,
      "height": 95,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": "s1",
      "fillStyle": "solid",
      "fontFamily": 5,
      "fontSize": 14,
      "frameId": null,
      "groupIds": [],
      "index": "aB",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "«Como tú digas»…\ny te quedas con\nla rabia dentro.\n\nNadie sabe\nlo que necesitas.\nEl otro no cambia\nporque ni se entera.",
      "roughness": 1,
      "roundness": null,
      "seed": 1156647576,
      "strokeColor": "#e67e22",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "«Como tú digas»…\ny te quedas con\nla rabia dentro.\n\nNadie sabe\nlo que necesitas.\nEl otro no cambia\nporque ni se entera.",
      "textAlign": "center",
      "updated": 1792273272092,
      "version": 1,
      "versionNonce": 385869472,
      "verticalAlign": "middle"
    },
    {
      "id": "s2-label",
      "type": "text",
      "x": 375,
      "y": 212.5,
      "width": 280,
      "height": 95,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": "s2",
      "fillStyle": "solid",
      "fontFamily": 5,
      "fontSize": 14,
      "frameId": null,
      "groupIds": [],
      "index": "aC",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "«Me molesta cuando\n[hecho]. Prefiero\nque [petición].»\n\nHablas del HECHO,\nno de la persona.\nGanas tú y gana\nel otro: GANAR-GANAR.",
      "roughness": 1,
      "roundness": null,
      "seed": 218803699,
      "strokeColor": "#00897b",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "«Me molesta cuando\n[hecho]. Prefiero\nque [petición].»\n\nHablas del HECHO,\nno de la persona.\nGanas tú y gana\nel otro: GANAR-GANAR.",
      "textAlign": "center",
      "updated": 1792273272092,
      "version": 1,
      "versionNonce": 595757225,
      "verticalAlign": "middle"
    },
    {
      "id": "s3-label",
      "type": "text",
      "x": 710,
      "y": 212.5,
      "width": 280,
      "height": 95,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": "s3",
      "fillStyle": "solid",
      "fontFamily": 5,
      "fontSize": 14,
      "frameId": null,
      "groupIds": [],
      "index": "aD",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "«Eres un [adj]».\nDices lo tuyo\nHERIR al otro.\n\nGanas la pelea\ny pierdes a la\npersona. El otro\ntambién escala.",
      "roughness": 1,
      "roundness": null,
      "seed": 1249286424,
      "strokeColor": "#c0392b",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "«Eres un [adj]».\nDices lo tuyo\nHERIR al otro.\n\nGanas la pelea\ny pierdes a la\npersona. El otro\ntambién escala.",
      "textAlign": "center",
      "updated": 1792273272092,
      "version": 1,
      "versionNonce": 273601010,
      "verticalAlign": "middle"
    },
    {
      "id": "u6f1-meta-label",
      "type": "text",
      "x": 40,
      "y": 417.5,
      "width": 950,
      "height": 55,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": "u6f1-meta",
      "fillStyle": "solid",
      "fontFamily": 5,
      "fontSize": 15,
      "frameId": null,
      "groupIds": [],
      "index": "aE",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "📌 El asertivo NO es el punto medio: es GANAR-GANAR — dices lo tuyo y el otro no queda destruido.\nSe prueba en el momento · con calma · mirando · hablando del acto, no de la persona.",
      "roughness": 1,
      "roundness": null,
      "seed": 1619107528,
      "strokeColor": "#2563eb",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "📌 El asertivo NO es el punto medio: es GANAR-GANAR — dices lo tuyo y el otro no queda destruido.\nSe prueba en el momento · con calma · mirando · hablando del acto, no de la persona.",
      "textAlign": "center",
      "updated": 1792273272092,
      "version": 1,
      "versionNonce": 2053278436,
      "verticalAlign": "middle"
    }
