      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "📌 Pista seria: si algo te hace perder la noción del tiempo, apúntalo — es información, no tontería.",
      "roughness": 1,
      "roundness": null,
      "seed": 761983241,
      "strokeColor": "#00897b",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "📌 Pista seria: si algo te hace perder la noción del tiempo, apúntalo — es información, no tontería.",
