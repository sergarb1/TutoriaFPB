      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Pedir ayuda no es fracasar: es pedir agua cuando tienes sed.\nCuantos antes lo cuentas, más fácil se arregla — y nadie se lo toma a broma.",
      "roughness": 1,
      "roundness": null,
      "seed": 1254003822,
      "strokeColor": "#2563eb",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "Pedir ayuda no es fracasar: es pedir agua cuando tienes sed.\nCuantos antes lo cuentas, más fácil se arregla — y nadie se lo toma a broma.",
      "textAlign": "center",
      "updated": 1792320546382,
