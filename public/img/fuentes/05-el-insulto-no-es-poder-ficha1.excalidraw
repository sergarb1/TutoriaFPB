      "groupIds": [],
      "index": "aB",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "🛑 SE CORTE ASÍ: sin premio (rostro de cartón, ni risa forzada ni respuesta) + apoyo del grupo (que nadie se ría) + LÍMITE claro.\n⚠️ Si persiste, se repite o son varios → SE AVISA. No es aguantar: es escoger batalla y pedir ayuda.",
      "roughness": 1,
      "roundness": null,
      "seed": 1801019894,
      "strokeColor": "#00897b",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "🛑 SE CORTE ASÍ: sin premio (rostro de cartón, ni risa forzada ni respuesta) + apoyo del grupo (que nadie se ría) + LÍMITE claro.\n⚠️ Si persiste, se repite o son varios → SE AVISA. No es aguantar: es escoger batalla y pedir ayuda.",
      "textAlign": "center",
      "updated": 1792272575857,
      "version": 1,
      "versionNonce": 2021543632,
      "verticalAlign": "middle"
    },
