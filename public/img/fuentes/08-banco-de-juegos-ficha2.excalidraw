      "fontFamily": 5,
      "fontSize": 14,
      "frameId": null,
      "groupIds": [],
      "index": "aD",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "No hay dinámica\nque valga: PARA\n+ método de 5\npasos o pedir\nMEDIACIÓN.\n\nLas dinámicas\nvienen DESPUÉS.",
      "roughness": 1,
      "roundness": null,
      "seed": 1155806111,
      "strokeColor": "#c0392b",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "No hay dinámica\nque valga: PARA\n+ método de 5\npasos o pedir\nMEDIACIÓN.\n\nLas dinámicas\nvienen DESPUÉS.",
      "textAlign": "center",
      "updated": 1792274993747,
      "version": 1,
      "versionNonce": 1187009451,
      "verticalAlign": "middle"
    },
    {
      "id": "u8f2-meta-label",
      "type": "text",
      "x": 40,
      "y": 408.75,
      "width": 950,
      "height": 47.5,
      "angle": 0,
