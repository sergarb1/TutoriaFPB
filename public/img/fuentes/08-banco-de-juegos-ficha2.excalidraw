      "groupIds": [],
      "index": "aB",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Clase tranquila:\nusan COHESIÓN —\ntelaraña, kudos,\nespeculo, 2 verdades.\n\nUnir ahora evita\nconflictos después.",
      "roughness": 1,
      "roundness": null,
      "seed": 1881193431,
      "strokeColor": "#00897b",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "Clase tranquila:\nusan COHESIÓN —\ntelaraña, kudos,\nespeculo, 2 verdades.\n\nUnir ahora evita\nconflictos después.",
      "textAlign": "center",
      "updated": 1792274993747,
      "version": 1,
      "versionNonce": 642827709,
      "verticalAlign": "middle"
    },
    {
      "id": "z2-label",
      "type": "text",
      "x": 375,
      "y": 210,
      "width": 280,
      "height": 90,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": "z2",
      "fillStyle": "solid",
      "fontFamily": 5,
      "fontSize": 14,
      "frameId": null,
      "groupIds": [],
      "index": "aC",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "El grupo está raro:\nbaja la tensión —\nrespiración, paño\nde la calma,\nturno de 60 s.\n\nNada forzado.",
      "roughness": 1,
      "roundness": null,
      "seed": 1981804668,
      "strokeColor": "#e67e22",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "El grupo está raro:\nbaja la tensión —\nrespiración, paño\nde la calma,\nturno de 60 s.\n\nNada forzado.",
      "textAlign": "center",
      "updated": 1792274993747,
      "version": 1,
      "versionNonce": 121616964,
      "verticalAlign": "middle"
    },
    {
      "id": "z3-label",
      "type": "text",
      "x": 710,
      "y": 210,
      "width": 280,
      "height": 90,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
