      "groupIds": [],
      "index": "aE",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "📌 Regla: nunca una dinámica de unión FORZADA en amarillo o rojo: aburre o incomoda.\nEn rojo solo el método de resolución (o la mediación). En verde, ¡adelante con la cohesión!",
      "roughness": 1,
      "roundness": null,
      "seed": 1739612789,
      "strokeColor": "#2563eb",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "📌 Regla: nunca una dinámica de unión FORZADA en amarillo o rojo: aburre o incomoda.\nEn rojo solo el método de resolución (o la mediación). En verde, ¡adelante con la cohesión!",
      "textAlign": "center",
